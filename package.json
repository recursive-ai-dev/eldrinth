{
  "name": "eldrinth",
  "private": true,
  "version": "1.0.0",
  "description": "ELDRINTH: The Unbound Spire — a 2D open-world dark-fantasy action RPG that runs entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:release": "node tools/verify-release.mjs",
    "bench": "vitest run --config bench/vitest.config.ts",
    "preview": "vite preview",
    "gen:sprites": "python3 tools/spritegen/gen_sprites.py",
    "portraits:gen": "node tools/generate-portraits.mjs",
    "portraits:zoom": ".venv/bin/python3 tools/zoom_portraits.py"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.14.2",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
