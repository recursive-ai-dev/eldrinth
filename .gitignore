# Build output is committed deliberately so a release can be served straight
# from a branch. It is regenerated by `npm run build` and must never be edited
# by hand.
# dist/

# Package manager: npm is the supported package manager and package-lock.json is
# the committed lockfile. A stray pnpm/bun lockfile resolves different versions
# and makes the committed dist/ unreproducible.
pnpm-lock.yaml
bun.lockb

